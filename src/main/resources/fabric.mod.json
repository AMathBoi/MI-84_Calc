{
  "schemaVersion": 1,
  "id": "mi84_calc",
  "version": "${version}",
  "name": "MI-84 Calculator",
  "description": "A client-side, in-inventory graphing calculator overlay for Minecraft.",
  "authors": ["AMathBoi"],
  "contact": {
    "homepage": "https://github.com/AMathBoi/MI-84_Calc",
    "sources": "https://github.com/AMathBoi/MI-84_Calc",
    "issues": "https://github.com/AMathBoi/MI-84_Calc/issues"
  },
  "license": "MIT",
  "icon": "assets/mi84_calc/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "value": "net.amathboi.mi84mod.Mi84_calc",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "net.amathboi.mi84mod.client.Mi84_calcClient",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "net.amathboi.mi84mod.client.Mi84_calcDataGenerator",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [

  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}
